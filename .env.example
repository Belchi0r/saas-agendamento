# Public Auth configuration. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Canonical external origin used to validate Origin and Host on mutations.
APP_ORIGIN=http://localhost:3000

# Runtime PostgreSQL URL. In serverless deployments use Supavisor transaction
# mode (port 6543) with the least-privileged runtime login.
DATABASE_URL=postgresql://runtime_user:replace_me@host:6543/postgres?sslmode=require
DB_POOL_MAX=2

# DDL connection used only by the Supabase CLI outside the application runtime.
MIGRATION_DATABASE_URL=postgresql://migration_user:replace_me@host:5432/postgres?sslmode=require

# Disposable PostgreSQL used only by database integration tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
